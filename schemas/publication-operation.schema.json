{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-study-path.dev/schemas/publication-operation.schema.json",
  "title": "Open Study Path projection operation journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "operation_type",
    "provider",
    "mode",
    "status",
    "topics",
    "attempt",
    "checkpoints",
    "external_read_count",
    "external_write_count",
    "commit_budget",
    "warnings",
    "errors",
    "started_at",
    "updated_at"
  ],
  "properties": {
    "operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "operation_type": {"enum": ["publication", "assessment_projection", "reconciliation", "migration"]},
    "provider": {"enum": ["trello", "todoist", "github_issues"]},
    "mode": {"enum": ["active_window", "full_curriculum"]},
    "status": {"enum": ["not_started", "in_progress", "partial", "blocked", "failed", "success"]},
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TOPIC-[0-9]{3,}$"}
    },
    "attempt": {"type": "integer", "minimum": 1},
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": true
      }
    },
    "external_read_count": {"type": "integer", "minimum": 0},
    "external_write_count": {"type": "integer", "minimum": 0},
    "roadmap_fingerprint": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "pull_request": {"type": ["integer", "null"], "minimum": 1},
    "commit_budget": {"type": "integer", "minimum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
